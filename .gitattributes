# Line endings are content here, not formatting.
#
# `soundingline/hashlock.py` hashes files as BYTES, deliberately — a line-ending change is a
# change, and silently normalising it would let a locked file drift while its hash held still.
# The consequence is that a checkout which converted LF to CRLF would fail every lock and be
# indistinguishable from someone editing a pre-registered criterion.
#
# So: LF everywhere, on every platform, enforced by the repository rather than by each
# contributor's git config.
* text=auto eol=lf

# Never touched by newline conversion.
*.png binary
*.pdf binary
*.jpg binary

# frozen adapters are hashed as bytes by the ADAPTERS registry: stored as-is, never eol-converted
results/**/adapters/** -text

# Completed Week 3 solver attempts already bind these bytes; preserve their
# existing CRLF rather than silently changing the recorded source hashes.
runners/drive/cards/week3_sdt_newton.py -text
runners/drive/cards/week3_sdt_recovery.py -text

# Preserve the original failed-test receipt's recorded bytes and SHA-256.
results/phase_2_4_stage_15/DRIVE/TR3_STATISTICS_TEST_FAILURE_20261027.xml -text whitespace=cr-at-eol
