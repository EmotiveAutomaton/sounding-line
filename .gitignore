# ---------------------------------------------------------------------------------------------
# SPEC §8: do not re-host the content. Store hashes and offsets publicly, text privately.
#
# These four rules are the security posture, not housekeeping. The corpus under study is
# adversarial content engineered to influence language models. Committing it would republish it.
corpora/store/
corpora/cache/
corpora/**/*.jsonl
corpora/**/*.txt
!corpora/manifests/
!corpora/manifests/**

# Credentials never enter the environment of any process that reads fetched text.
.env
.env.*
*.key

# ---------------------------------------------------------------------------------------------
# Ordinary Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Results: CSVs and verdict JSON are committed (they are the record). Raw model transcripts are
# not — they contain the artifact text, which the rule above says stays local.
results/**/transcripts/
results/**/raw/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# run logs are console captures with CRLF; the JSON verdict is the record
results/**/*.log

results/**/*.html
corpora/public/argrewrite/
corpora/public/pan_style/
results/decomp_scaling/cache/
results/.queue.lock
results/.loop.lock
results/.overnight.lock
results/queue_shard*.log
results/.loop.lock
results/.overnight.lock
results/.gear1.lock
results/.gear2.lock
results/.gpu.lock
results/.queue*.lock
results/features/*.building
results/use_cache/
results/scholawrite/dataset/
results/scholawrite/hf_cache/

# Stage 3 (2026-08): model weights are reproducible from the recipe files beside them; the
# recipe, the manifest, and the verdict are the record. Third-party passage banks stay local.
results/**/*.safetensors
results/**/*.bin
results/**/*.pt
results/phase_2_4_stage_3/H/H01/bank.json
results/phase_2_4_stage_3/H/H02/bank.json
results/.regear*.lock

# Stage-4 Quick, Draw! prefix files (CC BY 4.0, re-fetched by P01; never committed)
results/phase_2_4_stage_4/P01/raw/
results/.gear
results/**/adapters/*/epoch*/

# Local Codex runtime receipts, watcher state, and migration backups (no research data).
.agent-state/
# Machine-resolved hooks are generated by codex_setup; never commit absolute install paths.
.codex/hooks.json

# Machine-specific sandbox boundary is installed locally from Agent Core.
.codex/config.toml
